{
    "name": "@corebase/api",
    "version": "0.1.0",
    "description": "CoreBase API Server",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "test": "vitest",
        "test:watch": "vitest --watch",
        "test:coverage": "vitest --coverage",
        "test:workflow": "tsx scripts/test-workflow.ts",
        "docker:up": "docker-compose up -d",
        "docker:down": "docker-compose down",
        "docker:prod": "docker-compose -f docker-compose.prod.yml up -d --build",
        "lint": "eslint src --ext .ts"
    },
    "dependencies": {
        "@fastify/cors": "^8.5.0",
        "@fastify/jwt": "^7.2.4",
        "@fastify/rate-limit": "^9.1.0",
        "bcrypt": "^5.1.1",
        "dotenv": "^16.3.1",
        "fastify": "^4.25.2",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.11.3",
        "pino": "^8.17.2",
        "pino-pretty": "^10.3.1",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.10.6",
        "@types/pg": "^8.10.9",
        "@typescript-eslint/eslint-plugin": "^6.17.0",
        "@typescript-eslint/parser": "^6.17.0",
        "@vitest/coverage-v8": "^1.1.0",
        "eslint": "^8.56.0",
        "tsx": "^4.7.0",
        "typescript": "^5.3.3",
        "vitest": "^1.1.0"
    }
}