{
  "name": "corebase",
  "version": "0.1.0",
  "description": "Backend-as-a-Service platform - Self-hostable with auto-generated APIs",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@corebase/api",
    "dev:web": "npm run dev --workspace=@corebase/landing",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "migrate": "node scripts/migrate.js",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "baas",
    "backend",
    "api",
    "postgresql",
    "rest"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}